#!/usr/bin/env python3
"""score.py OUTPUT KEY [--json]: exact match per line + accuracy over the key's lines.
Deliverability check first: output must be exactly N integer lines."""
import sys, json
def score(out_text, key):
    n = len(key); lines = out_text.splitlines()
    ok = len(lines) == n and all(l.strip().lstrip('-').isdigit() for l in lines)
    if not ok:
        return {"deliverable": False, "reason": f"expected {n} integer lines, got {len(lines)}", "per_line": None, "accuracy": None}
    pl = [int(l) == k for l, k in zip(lines, key)]
    return {"deliverable": True, "per_line": [{"line": i+1, "exact": int(e)} for i, e in enumerate(pl)], "accuracy": sum(pl)/n}
if __name__ == "__main__":
    key = [c["words"] for c in json.load(open(sys.argv[2]))["counts"]]
    print(json.dumps(score(open(sys.argv[1]).read(), key), indent=1))
