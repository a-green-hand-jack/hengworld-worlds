#!/usr/bin/env python3
"""validate.py KEY: damage/stress checks on the measure. Prints JSON; exits 1 on failure."""
import sys, json
sys.path.insert(0, __file__.rsplit('/',1)[0])
from score import score
key = [c["words"] for c in json.load(open(sys.argv[1]))["counts"]]
n = len(key); fmt = lambda v: "\n".join(map(str, v)) + "\n"
r = {}
r["identical_output_holds"] = score(fmt(key), key)["accuracy"] == 1.0
for k in (1, 4, n):
    d = [v+1 if i < k else v for i, v in enumerate(key)]
    r[f"damage_{k}_lines_accuracy"] = score(fmt(d), key)["accuracy"]
    r[f"damage_{k}_drops_exactly"] = abs(score(fmt(d), key)["accuracy"] - (n-k)/n) < 1e-9
r["trailing_whitespace_holds"] = score(fmt(key).replace("\n", " \n"), key)["accuracy"] == 1.0
r["truncated_not_deliverable"] = score(fmt(key[:-1]), key)["deliverable"] is False
r["nonnumeric_not_deliverable"] = score(fmt(key[:-1]) + "x\n", key)["deliverable"] is False
r["empty_not_deliverable"] = score("", key)["deliverable"] is False
print(json.dumps(r, indent=1))
sys.exit(0 if all(v for k, v in r.items() if not k.endswith("accuracy")) else 1)
