#!/usr/bin/env python3
"""Usage: run_q_cuts.py DELIV_DIR KEY_DIR WORK FINGERPRINT_PREFIX FINGERPRINT_PY OUT.json  -- Q (check first) and cut F1 per task."""
import glob, importlib.util, json, os, sys
sys.path.insert(0, os.path.dirname(__file__))
import score_run
deliv, key, work, fpp, fppy, out = sys.argv[1:7]
spec = importlib.util.spec_from_file_location("fp", fppy); fp = importlib.util.module_from_spec(spec); spec.loader.exec_module(fp)
res = {}
for tdir in sorted(glob.glob(os.path.join(key, "coffee_run-*"))):
    task = os.path.basename(tdir); truth = json.load(open(os.path.join(tdir, "truth.json")))
    q = score_run.q_task(os.path.join(deliv, task), truth, fpp, fp)
    r = {"Q": q}
    if q["Q"]:
        r["cut"] = score_run.cuts_task(work, task, truth)
        r["scene"] = score_run.scene_order_task(work, task, truth)
    else:
        r["cut"] = {"F1_0.5": 0.0, "F1_1.0": 0.0, "note": "Q failed -> c = 0"}
        r["scene"] = {"scene_order": 0.0, "note": "Q failed -> c = 0"}
    res[task] = r
    print(task, q["Q"], q["Q_failed"], r["cut"].get("F1_0.5"), r["cut"].get("F1_1.0"), r["scene"]["scene_order"], flush=True)
json.dump(res, open(out, "w"), indent=1)
