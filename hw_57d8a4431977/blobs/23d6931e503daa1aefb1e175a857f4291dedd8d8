def bill(units: dict, price: dict) -> float:
    cost = price.get("per_call", 0.0) * units.get("calls", 0)
    cost += price.get("per_1k_chars", 0.0) * units.get("chars", 0) / 1000
    cost += price.get("per_second", 0.0) * units.get("seconds", 0.0)
    cost += price.get("per_gpu_second", 0.0) * units.get("gpu_seconds", 0.0)
    return round(cost, 6)


def ceil_seconds(x: float) -> float:
    return math.ceil(x * 10) / 10
