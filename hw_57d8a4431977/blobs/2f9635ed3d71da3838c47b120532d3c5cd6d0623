"""Stage (b): draft shot boundaries with an adaptive HSV content detector.

A cut is drafted where the mean absolute HSV difference between consecutive frames (on a
96x54 decode) is at least 15 and at least three times the mean difference of the frames two
and three positions away, or at least 45. The minimum shot is 0.5 s, fades through black are
not cuts, and repeated pull-down frames are skipped. Black-and-white films use the blurred,
mean-removed value channel with a threshold of 10. Per-shot colour histograms, luminance
histograms and 16x9 thumbnails are stored for scene linking in :mod:`crewcut.build.hierarchy`.
"""
import json
import subprocess

import cv2
import numpy as np

W, H = 96, 54


def probe(path):
    out = subprocess.run(
        ["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
         "stream=r_frame_rate,avg_frame_rate,duration:format=duration", "-of", "json", path],
        capture_output=True, text=True, check=True).stdout
    j = json.loads(out)
    st = j["streams"][0]
    num, den = st["avg_frame_rate"].split("/")
    fps = float(num) / float(den) if float(den) else 24.0
    if not (5 < fps < 61):
        num, den = st["r_frame_rate"].split("/")
        fps = float(num) / float(den)
    # ADAPTATION A1 (decisions/D-duration.json): duration_s is the video-stream duration, which is
    # what the published dataset records; the container duration also counts the longer audio track.
    return fps, float(st.get("duration") or j["format"]["duration"])


def frames(path):
    cmd = ["ffmpeg", "-v", "error", "-threads", "2", "-i", path, "-an", "-sn",
           "-vf", f"scale={W}:{H}:flags=area", "-pix_fmt", "bgr24", "-f", "rawvideo", "-"]
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, bufsize=W * H * 3 * 64)
    n = W * H * 3
    while True:
        buf = p.stdout.read(n)
        if len(buf) < n:
            break
        yield np.frombuffer(buf, np.uint8).reshape(H, W, 3)
    p.wait()


def detect(path):
    """Return the shot record for a video file."""
    fps, dur = probe(path)
    scores, vscores, hists, lums, ghists, sats, thumbs = [], [], [], [], [], [], []
    prev = None
    keep = []  # indices of frames that are not exact repeats (pull-down duplicates)
    for f in frames(path):
        hsv = cv2.cvtColor(f, cv2.COLOR_BGR2HSV).astype(np.int16)
        lums.append(float(hsv[..., 2].mean()))
        v = cv2.GaussianBlur(hsv[..., 2].astype(np.float32), (5, 5), 0)
        v = v - v.mean()
        if prev is not None:
            d = np.abs(hsv - prev[0]).reshape(-1, 3).mean(0)
            dv = float(np.abs(v - prev[1]).mean())
            if float(d.mean()) < 1.0:   # repeated frame, keep the previous reference
                scores.append(None)
                vscores.append(None)
            else:
                scores.append(float(d.mean()))
                vscores.append(dv)
                keep.append(len(lums) - 1)
                prev = (hsv, v)
        else:
            scores.append(0.0)
            vscores.append(0.0)
            keep.append(0)
            prev = (hsv, v)
        h = cv2.calcHist([f], [0, 1, 2], None, [8, 8, 8], [0, 256] * 3).flatten()
        hists.append((h / (h.sum() + 1e-9)).astype(np.float32))
        g = np.histogram(hsv[..., 2], bins=32, range=(0, 256))[0].astype(np.float32)
        ghists.append(g / (g.sum() + 1e-9))
        sats.append(float(hsv[..., 1].mean()))
        thumbs.append(cv2.resize(hsv[..., 2].astype(np.uint8), (16, 9), interpolation=cv2.INTER_AREA))
    # black-and-white films carry no hue or saturation change, so the content
    # score uses the blurred value channel alone, with each frame's mean removed
    # so that print flicker and grain do not read as cuts
    gray = float(np.mean(sats)) < 40 if sats else False
    n = len(lums)
    src = vscores if gray else scores
    s = np.array([src[i] for i in keep], dtype=float)
    m = len(s)
    win = 2
    cuts = []
    min_len = max(1, int(round(0.5 * fps)))
    last = 0
    for k in range(1, m):
        # neighbours two and three frames away, so that a cut spread over a
        # blended pull-down frame still stands out
        nb = [s[j] for j in (k - 3, k - 2, k + 2, k + 3) if 1 <= j < m]
        avg = float(np.mean(nb)) if nb else 0.0
        ratio = s[k] / (avg + 1e-3) if avg > 0.5 else (s[k] / 0.5 if s[k] > 0 else 0)
        lo_thr = 10.0 if gray else 15.0  # blurred luminance differences run lower
        is_cut = (s[k] >= lo_thr and ratio >= 3.0) or s[k] >= 45.0
        i = keep[k]
        # ignore fades through black
        if is_cut and min(lums[i], lums[i - 1]) < 8:
            is_cut = False
        if is_cut and i - last >= min_len:
            cuts.append(i)
            last = i
    bounds = [0] + cuts + [n]
    shot_hist = []
    for a, b in zip(bounds[:-1], bounds[1:]):
        idx = [a + (b - a) // 4, a + (b - a) // 2, a + 3 * (b - a) // 4]
        shot_hist.append(np.mean([hists[min(j, n - 1)] for j in idx], 0).round(5).tolist())
    shot_ghist = []
    for a, b in zip(bounds[:-1], bounds[1:]):
        idx = [a + (b - a) // 4, a + (b - a) // 2, a + 3 * (b - a) // 4]
        shot_ghist.append(np.mean([ghists[min(j, n - 1)] for j in idx], 0).round(5).tolist())
    shot_thumb = [np.mean([thumbs[min(j, n - 1)] for j in [a + (b - a) // 4, a + (b - a) // 2, a + 3 * (b - a) // 4]], 0).round(1).tolist()
                  for a, b in zip(bounds[:-1], bounds[1:])]
    return {"file": str(path), "shot_ghist": shot_ghist, "shot_thumb": shot_thumb, "mean_sat": round(float(np.mean(sats)), 2), "fps": fps, "duration": dur, "nframes": n,
               "cuts": cuts, "shot_hist": shot_hist,
               "mean_lum": [round(float(np.mean(lums[a:b])), 1) for a, b in zip(bounds[:-1], bounds[1:])]}


def run(path, out):
    rec = detect(path)
    json.dump(rec, open(out, "w"))
    return rec
