"""Stage (b): draft timed dialogue lines.

Speech is transcribed with Whisper behind a Silero voice-activity filter. Two back ends are
supported: ``whisper.cpp`` (what produced the released draft; base multilingual model, language
auto-detected) and ``faster-whisper`` (pip-installable). Whisper segments are split into lines at
sentence-final punctuation, with line times interpolated by character position; bracketed sound
tags and music symbols are dropped. Speaker attribution is left to the human pass.
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import tempfile
from pathlib import Path

NOISE = re.compile(r"[\[\(].*[\]\)]|[♪♫\s.,!?\-*]+")


def extract_wav(video: Path, wav: Path) -> None:
    subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", str(video), "-vn", "-ac", "1", "-ar", "16000", str(wav)],
                   check=True)


def has_audio(video: Path) -> bool:
    out = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "a", "-show_entries", "stream=index",
                          "-of", "csv=p=0", str(video)], capture_output=True, text=True).stdout
    return bool(out.strip())


def _whisper_cpp(wav: Path, root: Path, threads: int) -> tuple[str, list[tuple[float, float, str]]]:
    with tempfile.TemporaryDirectory() as td:
        of = Path(td) / "w"
        subprocess.run([str(root / "build/bin/whisper-cli"), "-m", str(root / "ggml-base.bin"), "-f", str(wav),
                        "-l", "auto", "-t", str(threads), "-bs", "1", "-bo", "1", "--vad",
                        "-vm", str(root / "ggml-silero.bin"), "-oj", "-of", str(of), "-np"],
                       check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        j = json.loads((of.with_suffix(".json")).read_text())
    segs = [(s["offsets"]["from"] / 1000, s["offsets"]["to"] / 1000, s["text"]) for s in j["transcription"]]
    return j.get("result", {}).get("language", ""), segs


def _faster_whisper(wav: Path, model: str, threads: int) -> tuple[str, list[tuple[float, float, str]]]:
    from faster_whisper import WhisperModel  # optional dependency
    m = WhisperModel(model, device="auto", cpu_threads=threads)
    segments, info = m.transcribe(str(wav), vad_filter=True, beam_size=1)
    return info.language, [(s.start, s.end, s.text) for s in segments]


def split_lines(segs) -> list[list]:
    lines = []
    for a, b, text in segs:
        parts = [p.strip() for p in re.split(r"(?<=[.?!])\s+", text.strip()) if p.strip()]
        tot = sum(len(p) for p in parts) or 1
        pos = 0
        for p in parts:
            if NOISE.fullmatch(p) or len(re.sub(r"\W", "", p)) < 2:
                pos += len(p)
                continue
            t0 = a + (b - a) * pos / tot
            pos += len(p)
            t1 = a + (b - a) * pos / tot
            lines.append([round(t0, 2), round(t1, 2), p])
    return lines


def transcribe(video: Path, backend: str = "faster-whisper", model: str = "base", threads: int = 2,
               whisper_cpp_root: str | None = None, silent: bool = False) -> dict:
    """Return ``{"lang": str, "lines": [[start, end, text], ...]}`` for a video file."""
    if silent or not has_audio(video):
        return {"lang": "", "lines": []}
    with tempfile.TemporaryDirectory() as td:
        wav = Path(td) / "a.wav"
        extract_wav(video, wav)
        if backend == "whisper.cpp":
            lang, segs = _whisper_cpp(wav, Path(whisper_cpp_root or os.environ.get("WHISPER_CPP", "whisper.cpp")), threads)
        else:
            lang, segs = _faster_whisper(wav, model, threads)
    return {"lang": lang, "lines": split_lines(segs)}
