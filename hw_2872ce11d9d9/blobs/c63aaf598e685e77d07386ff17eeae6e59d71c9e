import json, pathlib, re, hashlib, sys
p=pathlib.Path(sys.argv[1]); lines=p.read_text(encoding='utf-8').splitlines()
counts=[{"line":i,"words":len(re.findall(r'[^\s]+',line))} for i,line in enumerate(lines,1)]
out={"rule":"maximal run of non-whitespace characters","source":str(p),"counts":counts}
pathlib.Path(sys.argv[2]).write_text(json.dumps(out,indent=2)+"\n")
