#!/bin/sh
# Build the key-free task package and scan it for key content. Run after make_truth.py.
set -e
cp /wordcount-source/sentences.txt package/sentences.txt
cat > package/TASK.md <<'EOT'
# Word-count task
Input: `sentences.txt`, eight lines of UTF-8 text.
Output: for each line, the number of words on it, one integer per line, in order (8 lines, stdout).
A word is a maximal run of characters that are not whitespace (spaces, tabs). A hyphenated word or a number counts as one word.
Scoring: exact match per line; accuracy over the eight lines.
EOT
# key scan: no file in package may contain the key file or its count sequence
python3 -I - <<'EOP'
import json,os,sys
k=json.load(open('key/answer_key.json'))['counts']
seq=''.join(str(c['words']) for c in k)
for f in os.listdir('package'):
    t=open('package/'+f).read()
    if 'answer_key' in t or seq in t.replace('\n','').replace(' ',''): sys.exit('key content in package/'+f)
print('package clean')
EOP
