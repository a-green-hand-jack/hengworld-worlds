#!/usr/bin/env python3
"""validate.py KEY.json: damage/stress checks on the measure."""
import json, sys
from score import score
key = json.load(open(sys.argv[1])); exp = [c["words"] for c in key["counts"]]
mk = lambda v: "\n".join(map(str, v)) + "\n"
r = {}
r["identical_is_1.0"] = score(key, mk(exp))["accuracy"] == 1.0
r["no_trailing_newline_holds"] = score(key, mk(exp).rstrip("\n"))["accuracy"] == 1.0
for k in (1, 4, 8):
    d = [e + 1 if i < k else e for i, e in enumerate(exp)]
    r[f"damage_{k}_lines_acc"] = score(key, mk(d))["accuracy"] == (8-k)/8
r["all_wrong_0"] = score(key, mk([e+1 for e in exp]))["accuracy"] == 0.0
r["truncated_undeliverable"] = score(key, mk(exp[:7]))["deliverable"] is False
r["extra_text_undeliverable"] = score(key, mk(exp) + "done\n")["deliverable"] is False
print(json.dumps(r, indent=1)); sys.exit(0 if all(r.values()) else 1)
