import sys, json
src, ref, out, cmpout = sys.argv[1:5]
lines = open(src, encoding='utf-8').read().split('\n')
if lines and lines[-1] == '': lines.pop()
mine = [len(l.split()) for l in lines]  # str.split(): runs of whitespace (space, tab)
r = [c['words'] for c in sorted(json.load(open(ref))['counts'], key=lambda c: c['line'])]
diffs = [{'line': i+1, 'mine': a, 'reference': b} for i, (a, b) in enumerate(zip(mine, r)) if a != b]
json.dump({'rule': 'maximal run of non-whitespace', 'counts': [{'line': i+1, 'words': n} for i, n in enumerate(mine)]}, open(out, 'w'), indent=1)
json.dump({'n_lines': len(mine), 'n_reference': len(r), 'differences': diffs}, open(cmpout, 'w'), indent=1)
if len(mine) != len(r) or diffs:
    print('FAIL ground truth differs from reference', diffs); sys.exit(1)
print('OK ground truth equals reference on', len(mine), 'lines')
