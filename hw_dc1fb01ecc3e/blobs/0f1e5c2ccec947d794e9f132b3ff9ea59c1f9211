#!/usr/bin/env python3
"""score.py KEY.json OUTPUT.txt -> JSON: per-line exact match + accuracy.
Deliverability check first: exactly 8 lines, each a decimal integer."""
import json, re, sys
def score(key, text):
    exp = [c["words"] for c in key["counts"]]
    lines = text.split("\n")
    if lines and lines[-1] == "": lines = lines[:-1]
    ok = len(lines) == len(exp) and all(re.fullmatch(r"\d+", l.strip()) for l in lines)
    if not ok:
        return {"deliverable": False, "per_line": [0]*len(exp), "accuracy": 0.0}
    pl = [int(int(l) == e) for l, e in zip(lines, exp)]
    return {"deliverable": True, "per_line": pl, "accuracy": sum(pl)/len(exp)}
if __name__ == "__main__":
    print(json.dumps(score(json.load(open(sys.argv[1])), open(sys.argv[2]).read())))
